# ==============================================================================
# SIPPOL Deploy - Backend Environment Variables (.env.backend)
# Source: sippol-backend/.env.example
# ==============================================================================

APP_NAME="SIPPOL PP Buleleng"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

# FrankenPHP Web Server Listen Address
SERVER_NAME=":8000"

# Application Locale & Timezone
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Asia/Makassar

# Logging
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# Database Configuration (MySQL Production Service)
# Credentials here are automatically mapped to the sippol-mysql container!
# ------------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=sippol
DB_USERNAME=sippol_user
DB_PASSWORD=sippol_secret

# Optional explicit MySQL container root password (defaults to DB_PASSWORD)
MYSQL_ROOT_PASSWORD=sippol_secret

# Session & Cache
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database

# Auto-run Migrations & Seeders on Container Startup
AUTORUN_MIGRATIONS=true
RUN_SEEDERS=true

# Google reCAPTCHA Secret Key (server-side verification)
RECAPTCHA_SECRET_KEY=
