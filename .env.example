# ==============================================================================
# SIPPOL PP Buleleng - Deployment Environment Variables
# Salin file ini menjadi .env di dalam folder sippol-deploy/:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Konfigurasi Frontend (Next.js 16)
# ------------------------------------------------------------------------------
FRONTEND_PORT=3000

# URL endpoint backend yang diakses oleh browser pengguna.
# Untuk pengujian lokal: http://localhost:8000
# Untuk server produksi: https://api-sippol.bulelengkab.go.id
NEXT_PUBLIC_API_URL=http://localhost:8000

# Google reCAPTCHA v2 / v3 Site Key (kunci publik frontend)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# Internal Docker URL yang digunakan Next.js server-side rewrites untuk mem-proxy /api/*
INTERNAL_BACKEND_URL=http://backend:8000

# ------------------------------------------------------------------------------
# 2. Konfigurasi Backend (Laravel 12 API)
# ------------------------------------------------------------------------------
BACKEND_PORT=8000
APP_NAME="SIPPOL PP Buleleng"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

# Google reCAPTCHA Secret Key (kunci rahasia server untuk verifikasi token captcha)
RECAPTCHA_SECRET_KEY=

# Jalankan migrasi dan seeding otomatis saat kontainer backend pertama kali menyala
AUTORUN_MIGRATIONS=true
RUN_SEEDERS=true

# ------------------------------------------------------------------------------
# 3. Konfigurasi Basis Data
# ------------------------------------------------------------------------------
# Driver default: sqlite (tersimpan di volume persisten backend_database)
DB_CONNECTION=sqlite
DB_DATABASE=/var/www/html/database/database.sqlite

# Alternatif MySQL (aktifkan jika menggunakan MySQL eksternal / RDS)
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=sippol
# DB_USERNAME=sippol_user
# DB_PASSWORD=rahasia
