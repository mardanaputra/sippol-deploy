# ==============================================================================
# SIPPOL Deploy - Frontend Environment Variables (.env.frontend)
# Source: sippol-frontend/.env.example
# ==============================================================================

NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# Internal Docker URL used by Next.js server rewrites to proxy /api/* requests
INTERNAL_BACKEND_URL=http://backend:8000

# Public Browser-facing API URL (Leave blank to use Next.js built-in relative proxy)
NEXT_PUBLIC_API_URL=

# Google reCAPTCHA v2 / v3 Public Site Key
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=6LfNrjYtAAAAACTzDq41xhx2sj-19GKt_fgxp57x
